{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwoSecure",
  "version": "0.2.7",
  "identifier": "com.twosecure.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "title": "2Secure - Encrypted Vault",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "visible": true,
        "center": true,
        "focus": true,
        "backgroundColor": "#050508",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QzIxNUNEOTdFODEyQ0MKUldUTUV1aVh6UlhDOXVZc2FDa0Y2MGhKQ1c3NDlxdkdTTFFITzZ0TU1HeXBZYTFKU2lVWEdNdkUK",
      "endpoints": [
        "https://raw.githubusercontent.com/whoisthatlmao/Twosecure/main/releases/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}